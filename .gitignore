__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
!frontend/lib/
lib64/
.eggs/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.Python

# Pytest
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.cover
.hypothesis/

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / Black
.ruff_cache/

