# =============================================================================
# CampusOS — Environment Variables
# =============================================================================
# Copy this file to .env and replace placeholder values with real secrets.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=CampusOS
APP_VERSION=0.1.0
DEBUG=true

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Secret key used for app signing
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET_KEY

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_JWT_SECRET_KEY_MIN_32_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campusOS_db
POSTGRES_USER=campusOS_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Assembled by the application — leave blank (computed at runtime)
DATABASE_URL=postgresql+asyncpg://campusOS_user:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/campusOS_db

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# ---------------------------------------------------------------------------
# Frontend (Next.js — prefix with NEXT_PUBLIC_ to expose to browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=CampusOS

# ---------------------------------------------------------------------------
# Celery (Background Workers) — configured later
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/2

# ---------------------------------------------------------------------------
# AI / LLM — configured later
# ---------------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
# ANTHROPIC_API_KEY=
# VECTOR_DB_URL=

# ---------------------------------------------------------------------------
# Object Storage — configured later
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# ---------------------------------------------------------------------------
# Email / SMTP — configured later
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
